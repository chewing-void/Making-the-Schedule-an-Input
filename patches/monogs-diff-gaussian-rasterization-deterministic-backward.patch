+
+// Deterministic variant of BACKWARD::render. Same inputs plus the two pieces of
+// bookkeeping needed to address the per-instance scratch rows (point_offsets,
+// radii) and the scratch buffer itself, which the caller sizes R x (C + 7) and
+// zero-fills. Two launches: per-instance stores, then the fixed-order reduce.
+void BACKWARD::render_deterministic(
+	const dim3 grid, const dim3 block,
+	const uint2* ranges,
+	const uint32_t* point_list,
+	const uint32_t* point_offsets,
+	const int* radii,
+	int P, int R, int W, int H,
+	const float* bg_color,
+	const float2* means2D,
+	const float4* conic_opacity,
+	const float* colors,
+	const float* depths,
+	const float* final_Ts,
+	const uint32_t* n_contrib,
+	const float* dL_dpixels,
+	const float* dL_dpixels_depth,
+	float* tile_gradients,
+	float3* dL_dmean2D,
+	float4* dL_dconic2D,
+	float* dL_dopacity,
+	float* dL_dcolors,
+	float* dL_ddepths)
+{
+	(void)R;
+	renderDeterministicCUDA<NUM_CHANNELS> << <grid, block >> >(
+		ranges,
+		point_list,
+		point_offsets,
+		radii,
+		W, H,
+		bg_color,
+		means2D,
+		conic_opacity,
+		colors,
+		depths,
+		final_Ts,
+		n_contrib,
+		dL_dpixels,
+		dL_dpixels_depth,
+		tile_gradients
+	);
+
+	reduceTileGradientsCUDA<NUM_CHANNELS> << <(P + 255) / 256, 256 >> >(
+		P,
+		point_offsets,
+		tile_gradients,
+		dL_dmean2D,
+		dL_dconic2D,
+		dL_dopacity,
+		dL_dcolors,
+		dL_ddepths
+	);
+}
