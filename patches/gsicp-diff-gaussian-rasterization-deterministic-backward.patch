+void BACKWARD::render_deterministic(
+	const dim3 grid, dim3 block,
+	const uint2* ranges,
+	const uint32_t* point_list,
+	const uint32_t* point_offsets,
+	const int* radii,
+	int P, int R, int W, int H,
+	const float* bg_color,
+	const float2* means2D,
+	const float6* conic_opacity,
+	const float* depths,
+	const float* colors,
+	const float* final_Ts,
+	const float* final_Ts_d,
+	const float* final_accum_prob_d,
+	const uint32_t* n_contrib,
+	const float* final_depth,
+	const float* dL_dpixels_depth,
+	const float* dL_dpixels,
+	float* tile_gradients,
+	float3* dL_dmean2D,
+	float6* dL_dconic2D,
+	float* dL_dopacity,
+	float* dL_ddepths,
+	float* dL_dcolors)
+{
+	(void)R;
+	renderDeterministicCUDA<NUM_CHANNELS> <<<grid, block>>> (
+		ranges,
+		point_list,
+		point_offsets,
+		radii,
+		W, H,
+		bg_color,
+		means2D,
+		conic_opacity,
+		depths,
+		colors,
+		final_Ts,
+		final_Ts_d,
+		final_accum_prob_d,
+		n_contrib,
+		final_depth,
+		dL_dpixels_depth,
+		dL_dpixels,
+		tile_gradients);
+	reduceTileGradientsCUDA<NUM_CHANNELS> <<<(P + 255) / 256, 256>>> (
+		P,
+		point_offsets,
+		tile_gradients,
+		dL_dmean2D,
+		dL_dconic2D,
+		dL_dopacity,
+		dL_ddepths,
+		dL_dcolors);
+}
